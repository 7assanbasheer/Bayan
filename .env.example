# Bayan Aljafar Legal Website - Environment Configuration
# Copy this file to .env.local to activate automated server-side email dispatch

# Resend API Service (Recommended)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=notifications@bayan.law.sa
EMAIL_TO=b.a.alj3fr@hotmail.com

# Alternative: SMTP Credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://bayan.law.sa
NEXT_PUBLIC_DEFAULT_LOCALE=ar
